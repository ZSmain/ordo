		"typescript-eslint": "^8.67.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.2.2",
		"wrangler": "^4.124.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-valibot": "^0.4.2",
		"runed": "^0.37.1",
		"valibot": "^1.4.2"
